---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; h1: string; path: string; faq?: { q: string; a: string }[] }
const { title, description, h1, path, faq } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:8787';
const ld: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ArızaQR', item: site + '/' },
      { '@type': 'ListItem', position: 2, name: h1, item: site + path },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: h1, description,
    mainEntityOfPage: site + path, inLanguage: 'tr',
    author: { '@type': 'Organization', name: 'ArızaQR' },
    publisher: { '@type': 'Organization', name: 'ArızaQR' },
  },
];
if (faq?.length)
  ld.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
---
<Base title={title} description={description} path={path}>
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
    <nav aria-label="Konum" class="text-sm text-gri print:hidden">
      <a href="/" class="underline underline-offset-4">Ana sayfa</a> / {h1}
    </nav>
    <h1 class="plaka mt-4 text-3xl sm:text-5xl">{h1}</h1>
    <div class="yazi mt-8"><slot /></div>
    {faq && (
      <section class="mt-14 print:hidden">
        <h2 class="plaka text-2xl sm:text-3xl">Sık sorulan sorular</h2>
        <div class="mt-4 divide-y divide-dokum/25 border-y border-dokum/25">
          {faq.map((f) => <details class="py-4"><summary class="cursor-pointer font-semibold">{f.q}</summary><p class="mt-2 text-gri">{f.a}</p></details>)}
        </div>
      </section>
    )}
    <aside class="mt-14 border-2 border-dokum bg-sac p-6 print:hidden">
      <p class="plaka text-xl">Arızayı QR ile bildirin</p>
      <p class="mt-2 text-gri">ArızaQR ile her makineye bir etiket yapıştırırsınız, operatör telefonla okutup arızayı bildirir.</p>
      <a href={`${appUrl}/giris`} class="mt-4 inline-block rounded-sm bg-dokum px-5 py-3 font-semibold text-sac hover:bg-black">Ücretsiz dene</a>
    </aside>
  </main>
  <SiteFooter />
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</Base>
