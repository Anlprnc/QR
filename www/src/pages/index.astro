---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AndonDemo from '../components/AndonDemo';
import FloorDemo from '../components/FloorDemo';
import SpotlightCard from '../components/react-bits/SpotlightCard';

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:8787';
const steps = [
  { t: 'Makineye etiketi yapıştırın', d: 'Her makine için bir QR etiketi yazdırırsınız. Etiket makinenin adını ve yerini taşır.' },
  { t: 'Operatör telefonla okutur', d: 'Uygulama indirmek ya da giriş yapmak yok. Form tarayıcıda açılır, sorunu iki cümleyle yazar.' },
  { t: 'Bakım ekibi haberdar olur', d: 'Arıza anında panoya düşer ve ekibe e-posta gider. Birisi üstlenir, iş bitince ne yaptığını yazıp kapatır.' },
];
const states = [
  { c: 'bg-kirmizi', t: 'Arızalı', d: 'Bildirim geldi, henüz kimse bakmadı. Bekleyen işler en üstte durur.' },
  { c: 'bg-amber', t: 'Müdahale ediliyor', d: 'Bir teknisyen işi üstlendi. Kimin baktığı ve ne zamandır baktığı görünür.' },
  { c: 'bg-yesil', t: 'Çalışıyor', d: 'Arıza kapandı. Çözülme süresi kayıtta kalır, hangi makine sık bozuluyor görürsünüz.' },
];
const features = [
  { t: 'Makine durdu mu?', d: 'Operatör makinenin durup durmadığını işaretler. Duran makineler kırmızı şeritle en üstte görünür.' },
  { t: 'Üstlenme ve çözüm notu', d: 'Kim baktığı, ne yaptığı ve ne kadar sürdüğü kayıtta kalır. Aynı arıza tekrar ederse geçmişe bakarsınız.' },
  { t: 'Planlı bakım', d: '“Yağ kontrolü, 30 günde bir” gibi görevler tanımlayın. Vadesi gelen ve geciken bakımlar menüde görünür.' },
  { t: 'TV modu', d: 'Atölye duvarındaki ekranda tüm makinelerin durumu büyük lambalarla, kendiliğinden yenilenerek görünür.' },
  { t: 'Raporlar', d: 'Hangi makine sık bozuluyor, toplam ne kadar durdu, çözüm süresi kısalıyor mu? Excel’e de aktarılır.' },
  { t: 'Ekip ve e-posta', d: 'Ekip arkadaşlarınızı ekleyin; yeni arızada herkese e-posta gider. Şifre yok, kodla giriş.' },
];
const faq = [
  { q: 'Operatörün uygulama kurması gerekiyor mu?', a: 'Hayır. QR kodu telefon kamerasıyla okutması yeterli, form tarayıcıda açılır.' },
  { q: 'Excel ve WhatsApp grubundan farkı ne?', a: 'Arızalar makine bazında kayıt altında kalır, mesaj akışında kaybolmaz. Hangi makine ne sıklıkla arızalanıyor görebilirsiniz.' },
  { q: 'Planlı bakımı da takip edebilir miyim?', a: 'Evet. Makine başına periyodik bakım görevleri tanımlarsınız; vadesi gelince ve geciken bakımlar panelde görünür, yapıldığında tek tıkla işaretlenir.' },
  { q: 'Küçük atölyeler için uygun mu?', a: 'Evet. Büyük bakım yazılımları gibi karmaşık değil, birkaç makineyle de kullanılır.' },
];
---
<Base
  title="ArızaQR | QR Kodlu Arıza Takip Programı"
  description="Makineye QR kod yapıştırın, arıza bildirimi telefondan saniyeler içinde gelsin. Küçük imalatçılar için basit arıza ve bakım takip yazılımı."
>
  <SiteHeader />

  <main>
    <section class="mx-auto grid max-w-6xl gap-12 px-5 pb-20 pt-10 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:pt-16">
      <div>
        <h1 class="plaka text-4xl sm:text-6xl">Makine bozulunca herkes aynı anda öğrensin.</h1>
        <p class="mt-6 max-w-xl text-lg text-gri">
          Makineye bir QR etiketi yapıştırın. Operatör okutup arızayı bildirsin, bakım ekibinin panosuna ve e-postasına anında düşsün.
          Kurulum ve eğitim gerekmez.
        </p>
        <a href={`${appUrl}/giris`} class="mt-8 inline-block rounded-sm bg-dokum px-6 py-3 font-semibold text-sac hover:bg-black">Ücretsiz dene</a>
      </div>
      <AndonDemo client:visible />
    </section>

    <section class="bg-dokum">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 class="plaka max-w-2xl text-3xl text-sac sm:text-4xl">Atölyenizi tek bakışta görün</h2>
        <p class="mt-3 max-w-xl text-sac/70">Hangi makine çalışıyor, hangisi bekliyor, hangisine müdahale ediliyor. Deneyin: bir makineye dokunup arıza bildirin, sonra bakım panosundan üstlenin.</p>
        <div class="mt-8"><FloorDemo client:visible /></div>
      </div>
    </section>

    <section class="border-b-2 border-dokum bg-sac">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 class="plaka text-3xl sm:text-4xl">Üç adımda çalışır</h2>
        <ol class="mt-10 divide-y divide-dokum/25">
          {steps.map((s, i) => (
            <li class="grid gap-2 py-6 sm:grid-cols-[6rem_1fr_2fr] sm:items-baseline">
              <span class="plaka seri text-5xl text-gri">{i + 1}</span>
              <h3 class="text-xl font-bold">{s.t}</h3>
              <p class="max-w-prose text-gri">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="plaka text-3xl sm:text-4xl">Üç durum, üç renk</h2>
      <p class="mt-4 max-w-xl text-gri">Fabrikadaki andon lambası gibi: bir bakışta hangi makinenin ne durumda olduğunu görürsünüz.</p>
      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        {states.map((s) => (
          <li>
            <SpotlightCard client:visible theme="light" class="h-full p-6">
              <span class={`block h-4 w-4 rounded-full ${s.c}`}></span>
              <h3 class="mt-4 text-xl font-bold">{s.t}</h3>
              <p class="mt-2 text-gri">{s.d}</p>
            </SpotlightCard>
          </li>
        ))}
      </ul>
    </section>

    <section class="mx-auto max-w-6xl px-5 pb-20">
      <h2 class="plaka text-3xl sm:text-4xl">Bildirimden fazlası</h2>
      <p class="mt-4 max-w-xl text-gri">Arıza panosunun yanında küçük bir atölyenin ihtiyaç duyduğu bakım araçları.</p>
      <ul class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <li class="levha border-2 border-dokum bg-sac p-6">
            <h3 class="text-lg font-bold">{f.t}</h3>
            <p class="mt-2 text-gri">{f.d}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm"><a class="underline underline-offset-4" href="/periyodik-bakim-takibi">Periyodik bakım nasıl takip edilir?</a></p>
    </section>

    <section class="mx-auto max-w-3xl px-5 pb-24">
      <h2 class="plaka text-3xl sm:text-4xl">Sık sorulan sorular</h2>
      <div class="mt-8 divide-y divide-dokum/25 border-y border-dokum/25">
        {faq.map((f) => (
          <details class="py-4"><summary class="cursor-pointer font-semibold">{f.q}</summary><p class="mt-2 max-w-prose text-gri">{f.a}</p></details>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })} />
</Base>
