---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:8787';
---
<Base
  title="ArızaQR Fiyatlar | QR Kodlu Arıza Takip Programı"
  description="ArızaQR fiyatlandırması. Pilot dönemde küçük imalatçılar ücretsiz deneyebilir."
>
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="plaka text-4xl sm:text-5xl">Fiyatlar</h1>
    <p class="mt-6 max-w-xl text-lg text-gri">
      ArızaQR şu an pilot dönemde. Fiyatlandırma, ilk kullanıcıların nasıl kullandığına bakılarak netleşecek.
      Bu dönemde ücretsiz deneyebilirsiniz.
    </p>
    <a href={`${appUrl}/giris`} class="mt-8 inline-block rounded-sm bg-dokum px-6 py-3 font-semibold text-sac hover:bg-black">Ücretsiz dene</a>
    <h2 class="plaka mt-12 text-2xl">Pilot dönemde dahil olanlar</h2>
    <ul class="mt-4 list-disc space-y-1 pl-5 text-gri">
      <li>QR kodlu arıza bildirimi ve basılabilir makine etiketleri</li>
      <li>Arıza panosu: üstlenme, çözüm notu, geçmiş</li>
      <li>Planlı bakım takibi</li>
      <li>Raporlar ve Excel’e aktarma</li>
      <li>Atölye ekranı için TV modu</li>
      <li>Ekip üyeleri ve e-posta bildirimi</li>
    </ul>
    <p class="mt-10 text-sm text-gri">Fiyat tablosu, yayına çıkmadan önce burada yayınlanacak.</p>
  </main>
  <SiteFooter />
</Base>
