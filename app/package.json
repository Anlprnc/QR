{
  "name": "qr-ariza-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply qr-ariza --local",
    "db:seed": "wrangler d1 execute qr-ariza --local --file seeds/dev.sql"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261102.1": true
  }
}
